{
  "schemaVersion": 1,
  "id": "io.github.kvm404.laser-pointer",
  "name": "Laser Pointer",
  "version": "0.2.1",
  "author": "kvm404",
  "description": "A simple laser pointer for presentations and screen sharing.",
  "kinds": [
    "service",
    "bar-widget",
    "overlay"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "overlay": "Overlay.qml"
  },
  "barWidget": {
    "displayName": "Laser Pointer",
    "description": "Draw a fading trail while holding left-click.",
    "category": "Presentation",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "color": "#ff3b30",
      "thickness": 3
    }
  }
}
